# Copy to .env (or export as real env vars) for local runs outside of application.yml defaults
#
# Authentication is backed by Supabase Auth, proxied entirely through this backend's own
# /auth/* endpoints (register/verify-registration/login/forgot-password/reset-password) — the
# frontend never talks to Supabase directly. Verification is a one-time email code, not a
# magic link (a backend-only proxy has no clean way to complete a link-based flow). This means
# DB_HOST must point at a real Supabase Postgres project (via its Session Pooler connection,
# not Direct — Direct requires IPv6, which many hosts don't support outbound), not a plain
# local Postgres, since the auth.users table and its insert trigger only exist on Supabase.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=

SERVER_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_ENABLED=true
LOG_LEVEL=INFO

# Shared Supabase project credentials. SUPABASE_SECRET_KEY (sb_secret_..., Project Settings ->
# API Keys) is used for JWT verification (JWKS), the demo-account seeder (Admin API), and
# Supabase Storage if STORAGE_PROVIDER=supabase below — never expose it to the frontend.
# SUPABASE_PUBLISHABLE_KEY (sb_publishable_..., safe to expose) is what SupabaseAuthService uses
# for the user-facing signup/login/OTP calls it proxies.
SUPABASE_PROJECT_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Report photo storage provider: "local" (default, writes to disk under UPLOAD_DIR — fine for a
# single long-lived server, but lost on redeploy/restart on hosts with no persistent disk, e.g.
# Render's free tier) or "supabase" (uploads to a public Supabase Storage bucket instead).
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/api/uploads

# Only used when STORAGE_PROVIDER=supabase. Create a public bucket named this in your Supabase
# project's Storage tab first.
SUPABASE_STORAGE_BUCKET=report-images
SUPABASE_TIMEOUT_MS=15000

# AI detection provider: "mock" (default, deterministic, no external calls), "real" (calls
# the ai-service/ FastAPI+YOLOv8 microservice — see ai-service/README.md), or "roboflow"
# (calls Roboflow's hosted inference API directly, no self-hosting needed).
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000

# Only used when AI_PROVIDER=roboflow. Get a free API key from your Roboflow workspace's
# Settings -> API Keys, and a model ID from a trained Universe project's "Deploy Model" modal
# (format: "project-slug/version", e.g. "pathole-aynu3/1").
ROBOFLOW_BASE_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE_THRESHOLD=0.25

# Repair cost estimation provider: "rule" (default, free, deterministic formula in
# RepairEstimator — no external calls) or "gemini" (asks Google's free Gemini API to estimate
# cost from damage type/severity/confidence/location, with automatic fallback to the rule-based
# formula if the call fails). Get a free API key (no card required) from aistudio.google.com/apikey.
COST_PROVIDER=rule
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Delivery of the one-time signup/reset codes. Supabase mints the codes (via its Admin
# generate_link endpoint) but does NOT email them — this app does, so the template lives in
# code and works without Supabase's dashboard template editor (locked behind custom SMTP).
# "log" (default) prints the code to the console — no external calls, ideal for local dev.
# "resend" sends real branded email via Resend's REST API (free, 100/day, no card required —
# get a key at resend.com/api-keys). The REST API is used rather than SMTP deliberately:
# Resend's SMTP relay requires a verified sending domain, the REST API does not.
# RESEND_FROM_EMAIL can stay as the shared onboarding@resend.dev sender for testing (it only
# reliably delivers to your own Resend account email) or your own verified domain once you have one.
EMAIL_PROVIDER=log
RESEND_BASE_URL=https://api.resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=RoadVision AI <onboarding@resend.dev>
RESEND_TIMEOUT_MS=10000
