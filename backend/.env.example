# Copy to .env (or export as real env vars) for local runs outside of application.yml defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roadvision
DB_USER=roadvision
DB_PASSWORD=roadvision

SERVER_PORT=8080
JWT_SECRET=dev-only-secret-key-change-in-production-please-1234567890
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
SEED_ENABLED=true
LOG_LEVEL=INFO

# AI detection provider: "mock" (default, deterministic, no external calls) or "real"
# (calls the ai-service/ FastAPI+YOLOv8 microservice). See ai-service/README.md to deploy it.
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000
