# Copy to .env (or export as real env vars) for local runs outside of application.yml defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roadvision
DB_USER=roadvision
DB_PASSWORD=roadvision

SERVER_PORT=8080
JWT_SECRET=dev-only-secret-key-change-in-production-please-1234567890
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
SEED_ENABLED=true
LOG_LEVEL=INFO

# AI detection provider: "mock" (default, deterministic, no external calls), "real" (calls
# the ai-service/ FastAPI+YOLOv8 microservice — see ai-service/README.md), or "roboflow"
# (calls Roboflow's hosted inference API directly, no self-hosting needed).
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000

# Only used when AI_PROVIDER=roboflow. Get a free API key from your Roboflow workspace's
# Settings -> API Keys, and a model ID from a trained Universe project's "Deploy Model" modal
# (format: "project-slug/version", e.g. "pathole-aynu3/1").
ROBOFLOW_BASE_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE_THRESHOLD=0.25
